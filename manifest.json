{
  "manifest_version": 3,
  "name": "Doom Scroll",
  "version": "1.1.1",
  "author": "Mayank Singhal",
  "homepage_url": "https://doomscroll.web.app",
  "description": "Block distracting feeds and suggested content on social media platforms",
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://www.linkedin.com/*",
    "*://www.facebook.com/*",
    "*://web.facebook.com/*",
    "*://www.instagram.com/*",
    "*://x.com/*",
    "*://www.reddit.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://www.linkedin.com/*",
        "*://www.facebook.com/*",
        "*://web.facebook.com/*",
        "*://www.instagram.com/*",
        "*://x.com/*",
        "*://www.reddit.com/*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
